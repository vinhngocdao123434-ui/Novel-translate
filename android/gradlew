#!/usr/bin/env bash
# DroidTranslator Gradle Wrapper Script
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$DIR"

if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
else
    echo "Gradle not found in PATH. Please install Gradle 8.7+ or run through GitHub Actions."
    exit 1
fi
